# =============================================================================
#  brand.env — dados da marca usados na publicação dos cursos
#  Kit: Course Factory (pré-molde neutro) · contrato: course-factory-brand
# -----------------------------------------------------------------------------
#  Este é o MOLDE. Copie o kit para fora de `template/`, troque estes valores
#  pelos da sua marca e guarde a cópia no seu próprio repositório:
#
#      python3 tools/sync-brand.py --from-template
#
#  NENHUM SEGREDO AQUI — senha, token e chave moram no cofre, nunca em um kit
#  de marca. Estes campos vão impressos na capa, nos créditos e no rodapé.
# =============================================================================

# --- identidade --------------------------------------------------------------
# BRAND_NAME        como a marca assina (capa, rodapé, colofão)
# BRAND_NAME_LOWER  a mesma coisa em caixa baixa, para o rodapé dos slides
# BRAND_TAGLINE     uma linha, no máximo seis palavras
# BRAND_DESCRIPTOR  o que a marca faz, para a página de créditos
BRAND_NAME=Course Factory
BRAND_NAME_LOWER=course factory
BRAND_TAGLINE=Do assunto ao livro.
BRAND_DESCRIPTOR=Tecnologia · Ciência · Conhecimento
BRAND_CATEGORY=Material didático gerado com apoio de agente de IA

# --- pessoas -----------------------------------------------------------------
# ESTES CAMPOS VÃO IMPRESSOS NA CAPA E NOS METADADOS DO PDF, e por isso nascem
# VAZIOS: um placeholder aqui viraria um nome falso assinando um livro real.
# Vazio, a linha "AUTOR & ORIENTADOR" simplesmente some da capa.
#
# BRAND_OWNER   nome civil completo: autoria e orientação do material
#               (ex.: BRAND_OWNER=Maria Silva Pereira)
# BRAND_AUTHOR  forma curta, para as propriedades do PDF
#               (ex.: BRAND_AUTHOR=Maria S. Pereira)
#
# Prefere não gravar no kit? Passe na linha de comando: --advisor "Maria Silva".
BRAND_OWNER=
BRAND_AUTHOR=

# --- contato -----------------------------------------------------------------
BRAND_EMAIL=
BRAND_SITE=
BRAND_SITE_URL=

# --- assinatura visual -------------------------------------------------------
# BRAND_PROMPT  o prompt de terminal que abre as telas de seção (LaTeX cru)
BRAND_PROMPT=\textasciitilde/course \$

# --- cores -------------------------------------------------------------------
#  ESTA É A FONTE ÚNICA DAS CORES desta marca.
#
#  Cada BRAND_COLOR_<nome> vira um \definecolor no brand-env.tex, que os .sty
#  leem DEPOIS dos próprios padrões — então o que está aqui vence. Recolorir a
#  marca inteira é editar este bloco, e mais nada.
#
#  Formato: BRAND_COLOR_<nome LaTeX>=RRGGBB   (o "#" é opcional; o que vem
#  depois dos seis dígitos é comentário e não vai para o PDF).
#
#  palette/tokens.json e palette/tokens.css são GERADOS daqui:
#      python3 tools/sync-brand.py --palette

BRAND_COLOR_cfInk=101620        # fundo escuro de capa e de slide; texto sobre papel
BRAND_COLOR_cfPanel=19202B      # superfície elevada sobre o fundo escuro
BRAND_COLOR_cfBorder=2A3442     # contorno de bloco e de código no escuro
BRAND_COLOR_cfBlue=3B82F6       # cor condutora: filetes, títulos, marcadores
BRAND_COLOR_cfBlueDeep=1D4ED8   # o azul que passa em contraste sobre papel branco
BRAND_COLOR_cfBlueSoft=93B8FC   # azul sobre fundo escuro, para texto de apoio
BRAND_COLOR_cfTeal=14B8A6       # segunda voz: diagramas, subitens, ênfase secundária
BRAND_COLOR_cfTealDeep=0D7D70   # o turquesa legível sobre papel
BRAND_COLOR_cfAmber=F0B429      # destaque único da tela — no máximo um por slide
BRAND_COLOR_cfPaper=F6F7F9      # papel do miolo impresso
BRAND_COLOR_cfPaperHi=FFFFFF    # superfície de bloco sobre papel
BRAND_COLOR_cfRule=D8DDE5       # filete e borda no claro
BRAND_COLOR_cfMuted=8A94A6      # texto de apoio sobre fundo escuro
BRAND_COLOR_cfSupport=5A6472    # texto de apoio sobre papel

# --- cores do conversor ------------------------------------------------------
#  Estas o md2book pinta sozinho, a partir do JSON, antes de qualquer .sty ser
#  carregado — por isso precisam ser declaradas à parte. Mantenha-as coerentes
#  com o bloco acima; o `sync-brand.py --colors` mostra as duas lado a lado.

BRAND_BOOK_ACCENT=1D4ED8          # filete e destaque do livro (sobre papel)
BRAND_BOOK_CODE_BG=F6F7F9         # fundo do bloco de código no livro
BRAND_BOOK_CODE_BORDER=D8DDE5     # borda do bloco de código no livro

BRAND_SLIDES_ACCENT=3B82F6        # filete e destaque do slide (sobre escuro)
BRAND_SLIDES_CODE_BG=19202B       # fundo do bloco de código no slide
BRAND_SLIDES_CODE_BORDER=2A3442   # borda do bloco de código no slide
BRAND_SLIDES_CODE_FG=F6F7F9       # texto do bloco de código no slide
BRAND_SLIDES_MUTED=8A94A6         # texto de apoio no slide

# --- padrões editoriais do material -----------------------------------------
# BRAND_COURSE_LEVEL    linha de nível impressa na capa do livro
# BRAND_COURSE_LICENSE  linha de licença impressa na página de créditos
BRAND_COURSE_LEVEL=do zero absoluto ao nível de pesquisa
BRAND_COURSE_LICENSE=
